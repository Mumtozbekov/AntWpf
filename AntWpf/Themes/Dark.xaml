<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Options="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="Options">

    <!--  Dark theme colors (Ant Design v5 dark algorithm). Must define exactly the same keys as
          Light.xaml. Brushes must stay frozen: state storyboards animate brush colors and rely
          on WPF cloning frozen brushes per control.  -->

    <!--  Colors  -->
    <!--  Primary palette, Ant Design v5 color tokens: 1 Bg, 2 BgHover, 3 Border, 4 BorderHover,
          5 Hover, 6 Primary, 7 Active, 8 TextHover, 9 Text, 10 TextActive.
          Ant Design v5 dark algorithm: the light palette mixed over #141414, tokens 8..10 repeat 5..7.
          Brushes that follow the primary color reference these tokens; Color keys (PrimaryColor,
          PrimaryHoverColor, ...) repeat the value because a Color resource cannot alias another one.
          ThemeManager.SetPrimaryColor overrides the same keys: keep its key table in sync.  -->
    <Color x:Key="Primary1Color">#111A2C</Color>
    <Color x:Key="Primary2Color">#112545</Color>
    <Color x:Key="Primary3Color">#15325B</Color>
    <Color x:Key="Primary4Color">#15417E</Color>
    <Color x:Key="Primary5Color">#3C89E8</Color>
    <Color x:Key="Primary6Color">#1668DC</Color>
    <Color x:Key="Primary7Color">#1554AD</Color>
    <Color x:Key="Primary8Color">#3C89E8</Color>
    <Color x:Key="Primary9Color">#1668DC</Color>
    <Color x:Key="Primary10Color">#1554AD</Color>

    <Color x:Key="PrimaryColor">#1668DC</Color> <!--  = Primary6Color  -->
    <Color x:Key="InfoColor">#1668DC</Color>
    <Color x:Key="SuccessColor">#49AA19</Color>
    <Color x:Key="ProcessingColor">#1668DC</Color>
    <Color x:Key="Blue3">#15325B</Color> <!--  = Primary3Color  -->
    <Color x:Key="Blue4">#15417E</Color> <!--  = Primary4Color  -->
    <Color x:Key="ErrorColor">#DC4446</Color>
    <Color x:Key="HighlightColor">#DC4446</Color>
    <Color x:Key="WarningColor">#D89614</Color>
    <Color x:Key="NormalColor">#424242</Color>
    <Color x:Key="HeadingColor">#D9FFFFFF</Color>
    <Color x:Key="TextColor">#D9FFFFFF</Color>
    <Color x:Key="TextSecondaryColor">#A6FFFFFF</Color>
    <Color x:Key="TextTertiaryColor">#73FFFFFF</Color>
    <Color x:Key="BorderColorBase">#424242</Color>
    <Color x:Key="BorderColorSecondary">#303030</Color>
    <Color x:Key="BackgroundColorLight">#111A2C</Color> <!--  = Primary1Color  -->
    <Color x:Key="BackgroundColorBase">#14FFFFFF</Color>
    <Color x:Key="DisabledColor">#40FFFFFF</Color>
    <Color x:Key="DisabledBackground">#14FFFFFF</Color>
    <Color x:Key="DisabledColorDark">#59FFFFFF</Color>
    <Color x:Key="ContainerBackgroundColor">#141414</Color>
    <Color x:Key="ElevatedBackgroundColor">#1F1F1F</Color>
    <Color x:Key="TextOnPrimaryColor">#FFFFFF</Color>
    <Color x:Key="SwitchHandleShadowColor">#005317</Color>
    <Color x:Key="SuccessBackgroundColor">#162312</Color>
    <Color x:Key="SuccessBorderColor">#274916</Color>
    <Color x:Key="InfoBackgroundColor">#111A2C</Color>
    <Color x:Key="InfoBorderColor">#15325B</Color>
    <Color x:Key="WarningBackgroundColor">#2B2111</Color>
    <Color x:Key="WarningBorderColor">#594214</Color>
    <Color x:Key="ErrorBackgroundColor">#2C1618</Color>
    <Color x:Key="ErrorBorderColor">#5B2526</Color>
    <Color x:Key="PrimaryHoverColor">#3C89E8</Color> <!--  = Primary5Color  -->
    <Color x:Key="PrimaryActiveColor">#1554AD</Color> <!--  = Primary7Color  -->
    <Color x:Key="ShadowColor">#000000</Color>

    <!--  Color Brushs  -->
    <SolidColorBrush
        x:Key="Primary1Brush"
        Options:Freeze="True"
        Color="{StaticResource Primary1Color}" />
    <SolidColorBrush
        x:Key="Primary2Brush"
        Options:Freeze="True"
        Color="{StaticResource Primary2Color}" />
    <SolidColorBrush
        x:Key="Primary3Brush"
        Options:Freeze="True"
        Color="{StaticResource Primary3Color}" />
    <SolidColorBrush
        x:Key="Primary4Brush"
        Options:Freeze="True"
        Color="{StaticResource Primary4Color}" />
    <SolidColorBrush
        x:Key="Primary5Brush"
        Options:Freeze="True"
        Color="{StaticResource Primary5Color}" />
    <SolidColorBrush
        x:Key="Primary6Brush"
        Options:Freeze="True"
        Color="{StaticResource Primary6Color}" />
    <SolidColorBrush
        x:Key="Primary7Brush"
        Options:Freeze="True"
        Color="{StaticResource Primary7Color}" />
    <SolidColorBrush
        x:Key="Primary8Brush"
        Options:Freeze="True"
        Color="{StaticResource Primary8Color}" />
    <SolidColorBrush
        x:Key="Primary9Brush"
        Options:Freeze="True"
        Color="{StaticResource Primary9Color}" />
    <SolidColorBrush
        x:Key="Primary10Brush"
        Options:Freeze="True"
        Color="{StaticResource Primary10Color}" />
    <SolidColorBrush
        x:Key="PrimaryBrush"
        Options:Freeze="True"
        Color="{StaticResource Primary6Color}" />
    <SolidColorBrush
        x:Key="InfoBrush"
        Options:Freeze="True"
        Color="{StaticResource InfoColor}" />
    <SolidColorBrush
        x:Key="SuccessBrush"
        Options:Freeze="True"
        Color="{StaticResource SuccessColor}" />
    <SolidColorBrush
        x:Key="ProcessingBrush"
        Options:Freeze="True"
        Color="{StaticResource ProcessingColor}" />
    <SolidColorBrush
        x:Key="ErrorBrush"
        Options:Freeze="True"
        Color="{StaticResource ErrorColor}" />
    <SolidColorBrush
        x:Key="HighlightBrush"
        Options:Freeze="True"
        Color="{StaticResource HighlightColor}" />
    <SolidColorBrush
        x:Key="WarningBrush"
        Options:Freeze="True"
        Color="{StaticResource WarningColor}" />
    <SolidColorBrush
        x:Key="NormalBrush"
        Options:Freeze="True"
        Color="{StaticResource NormalColor}" />
    <SolidColorBrush
        x:Key="ContainerBackgroundBrush"
        Options:Freeze="True"
        Color="{StaticResource ContainerBackgroundColor}" />
    <SolidColorBrush
        x:Key="ElevatedBackgroundBrush"
        Options:Freeze="True"
        Color="{StaticResource ElevatedBackgroundColor}" />
    <SolidColorBrush
        x:Key="TextOnPrimaryBrush"
        Options:Freeze="True"
        Color="{StaticResource TextOnPrimaryColor}" />
    <SolidColorBrush
        x:Key="SuccessBackgroundBrush"
        Options:Freeze="True"
        Color="{StaticResource SuccessBackgroundColor}" />
    <SolidColorBrush
        x:Key="SuccessBorderBrush"
        Options:Freeze="True"
        Color="{StaticResource SuccessBorderColor}" />
    <SolidColorBrush
        x:Key="InfoBackgroundBrush"
        Options:Freeze="True"
        Color="{StaticResource InfoBackgroundColor}" />
    <SolidColorBrush
        x:Key="InfoBorderBrush"
        Options:Freeze="True"
        Color="{StaticResource InfoBorderColor}" />
    <SolidColorBrush
        x:Key="WarningBackgroundBrush"
        Options:Freeze="True"
        Color="{StaticResource WarningBackgroundColor}" />
    <SolidColorBrush
        x:Key="WarningBorderBrush"
        Options:Freeze="True"
        Color="{StaticResource WarningBorderColor}" />
    <SolidColorBrush
        x:Key="ErrorBackgroundBrush"
        Options:Freeze="True"
        Color="{StaticResource ErrorBackgroundColor}" />
    <SolidColorBrush
        x:Key="ErrorBorderBrush"
        Options:Freeze="True"
        Color="{StaticResource ErrorBorderColor}" />
    <SolidColorBrush
        x:Key="PrimaryHoverBrush"
        Options:Freeze="True"
        Color="{StaticResource Primary5Color}" />
    <SolidColorBrush
        x:Key="PrimaryActiveBrush"
        Options:Freeze="True"
        Color="{StaticResource Primary7Color}" />

    <!-- Background color for `<Window>` -->
    <SolidColorBrush
        x:Key="BodyBackground"
        Options:Freeze="True"
        Color="#141414" />

    <!--  Base background color for most components  -->
    <SolidColorBrush
        x:Key="ComponentBackground"
        Options:Freeze="True"
        Color="{StaticResource ContainerBackgroundColor}" />
    <SolidColorBrush x:Key="HeadingBrush" Color="{StaticResource HeadingColor}" />
    <SolidColorBrush
        x:Key="TextBrush"
        Options:Freeze="True"
        Color="{StaticResource TextColor}" />
    <SolidColorBrush
        x:Key="TextSecondaryBrush"
        Options:Freeze="True"
        Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush
        x:Key="TextTertiaryBrush"
        Options:Freeze="True"
        Color="{StaticResource TextTertiaryColor}" />
    <SolidColorBrush
        x:Key="IconBrush"
        Options:Freeze="True"
        Color="{StaticResource TextTertiaryColor}" />
    <SolidColorBrush
        x:Key="IconHoverBrush"
        Options:Freeze="True"
        Color="{StaticResource TextColor}" />

    <!--  @Primary1  -->
    <SolidColorBrush
        x:Key="ItemMouseOverBackground"
        Options:Freeze="True"
        Color="#14FFFFFF" />

    <!--  LINK  -->
    <SolidColorBrush
        x:Key="LinkBrush"
        Options:Freeze="True"
        Color="#1668DC" />
    <SolidColorBrush
        x:Key="LinkHoverBrush"
        Options:Freeze="True"
        Color="#15417E" />
    <SolidColorBrush
        x:Key="LinkActiveBrush"
        Options:Freeze="True"
        Color="#1554AD" />

    <!--  Border  -->
    <SolidColorBrush
        x:Key="BorderBrushBase"
        Options:Freeze="True"
        Color="{StaticResource BorderColorBase}" />
    <SolidColorBrush
        x:Key="BorderBrushSecondary"
        Options:Freeze="True"
        Color="{StaticResource BorderColorSecondary}" />
    <SolidColorBrush
        x:Key="BorderBrushSplit"
        Options:Freeze="True"
        Color="#1FFDFDFD" />

    <!--  Outline  -->
    <SolidColorBrush
        x:Key="OutlineBrush"
        Options:Freeze="True"
        Color="{StaticResource Primary6Color}" />

    <!--  background of header and selected item  -->
    <SolidColorBrush
        x:Key="BackgroundBrushLight"
        Options:Freeze="True"
        Color="{StaticResource Primary1Color}" />

    <!--  Disabled states  -->
    <SolidColorBrush
        x:Key="DisabledBrush"
        Options:Freeze="True"
        Color="{StaticResource DisabledColor}" />

    <!--  Window  -->
    <SolidColorBrush
        x:Key="WindowTilteBarForeground"
        Options:Freeze="True"
        Color="{StaticResource TextOnPrimaryColor}" />
    <SolidColorBrush
        x:Key="WindowTilteBarBackground"
        Options:Freeze="True"
        Color="{StaticResource Primary6Color}" />
    <SolidColorBrush
        x:Key="WindowButtonFocusedBrush"
        Options:Freeze="True"
        Color="#26FFFFFF" />
    <SolidColorBrush
        x:Key="WindowButtonPressedBrush"
        Options:Freeze="True"
        Color="#4CFFFFFF" />

    <!--  Buttons  -->
    <SolidColorBrush
        x:Key="ButtonPrimaryForeground"
        Options:Freeze="True"
        Color="{StaticResource TextOnPrimaryColor}" />
    <SolidColorBrush
