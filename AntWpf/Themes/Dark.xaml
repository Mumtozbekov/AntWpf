        Options:Freeze="True"
        Color="{StaticResource ContainerBackgroundColor}" />
    <SolidColorBrush
        x:Key="ButtonDefaultBorder"
        Options:Freeze="True"
        Color="{StaticResource BorderColorBase}" />
    <SolidColorBrush
        x:Key="ButtonDangerForeground"
        Options:Freeze="True"
        Color="{StaticResource ErrorColor}" />
    <SolidColorBrush
        x:Key="ButtonDangerBackground"
        Options:Freeze="True"
        Color="{StaticResource BackgroundColorBase}" />
    <SolidColorBrush
        x:Key="ButtonDangerBorder"
        Options:Freeze="True"
        Color="{StaticResource BorderColorBase}" />
    <SolidColorBrush
        x:Key="ButtonDisableForeground"
        Options:Freeze="True"
        Color="{StaticResource DisabledColor}" />
    <SolidColorBrush
        x:Key="ButtonDisableBackground"
        Options:Freeze="True"
        Color="{StaticResource DisabledBackground}" />
    <SolidColorBrush
        x:Key="ButtonDisableBorder"
        Options:Freeze="True"
        Color="{StaticResource BorderColorBase}" />

    <!--  CheckBox  -->
    <SolidColorBrush
        x:Key="CheckBoxBrush"
        Options:Freeze="True"
        Color="{StaticResource Primary6Color}" />

    <!--  Radio  -->
    <SolidColorBrush
        x:Key="RadioDotBrush"
        Options:Freeze="True"
        Color="{StaticResource Primary6Color}" />

    <!--  Radio Button  -->
    <SolidColorBrush
        x:Key="RadioButtonBackground"
        Options:Freeze="True"
        Color="{StaticResource ContainerBackgroundColor}" />

    <!--  Input  -->
    <SolidColorBrush
        x:Key="InputPlaceholderBrush"
        Options:Freeze="True"
        Color="#40FFFFFF" />
    <SolidColorBrush
        x:Key="InputForeground"
        Options:Freeze="True"
        Color="{StaticResource TextColor}" />
    <SolidColorBrush
        x:Key="InputBorderBrush"
        Options:Freeze="True"
        Color="{StaticResource BorderColorBase}" />
    <SolidColorBrush
        x:Key="InputBackground"
        Options:Freeze="True"
        Color="{StaticResource ContainerBackgroundColor}" />
    <SolidColorBrush
        x:Key="InputMouseOverBorderBrush"
        Options:Freeze="True"
        Color="{StaticResource Primary6Color}" />
    <SolidColorBrush
        x:Key="InputDisabledBackground"
        Options:Freeze="True"
        Color="{StaticResource DisabledBackground}" />

    <!--  ToolTip  -->
    <SolidColorBrush
        x:Key="ToolTipForeground"
        Options:Freeze="True"
        Color="{StaticResource TextOnPrimaryColor}" />
    <SolidColorBrush
        x:Key="ToolTipBackground"
        Options:Freeze="True"
        Color="#424242" />

    <!--  Tag  -->
    <SolidColorBrush
        x:Key="TagDefaultBackground"
        Options:Freeze="True"
        Color="#0AFFFFFF" />
    <SolidColorBrush
        x:Key="TagDefaultForeground"
        Options:Freeze="True"
        Color="{StaticResource TextColor}" />
    <SolidColorBrush
        x:Key="TagDefaultBorder"
        Options:Freeze="True"
        Color="{StaticResource BorderColorBase}" />

    <!--  Badge  -->
    <SolidColorBrush
        x:Key="BadgeBackground"
        Options:Freeze="True"
        Color="{StaticResource ErrorColor}" />
    <SolidColorBrush
        x:Key="BadgeForeground"
        Options:Freeze="True"
        Color="{StaticResource TextOnPrimaryColor}" />
    <SolidColorBrush
        x:Key="BadgeRingBrush"
        Options:Freeze="True"
        Color="{StaticResource ContainerBackgroundColor}" />
    <SolidColorBrush
        x:Key="BadgeStatusDefaultBrush"
        Options:Freeze="True"
        Color="{StaticResource DisabledColor}" />

    <!--  Tabs (v5 colorFillAlter)  -->
    <SolidColorBrush
        x:Key="TabsCardBackground"
        Options:Freeze="True"
        Color="#0AFFFFFF" />

    <!--  Modal (v5 colorBgMask) and text button hover (v5 colorBgTextHover)  -->
    <SolidColorBrush
        x:Key="ModalMaskBrush"
        Options:Freeze="True"
        Color="#73000000" />
    <SolidColorBrush
        x:Key="TextHoverBackgroundBrush"
        Options:Freeze="True"
        Color="#1FFFFFFF" />

    <!--  Avatar  -->
    <SolidColorBrush
        x:Key="AvatarBackground"
        Options:Freeze="True"
        Color="#40FFFFFF" />
    <SolidColorBrush
        x:Key="AvatarForeground"
        Options:Freeze="True"
        Color="{StaticResource TextOnPrimaryColor}" />

    <!--  Switch  -->
    <SolidColorBrush
        x:Key="SwitchBrush"
        Options:Freeze="True"
        Color="{StaticResource Primary6Color}" />

    <!--Slider-->
    <SolidColorBrush
     x:Key="SliderBackgroundBrush"
     Options:Freeze="True"
     Color="{StaticResource Primary3Color}" />
    <SolidColorBrush
     x:Key="SliderHoverBrush"
     Options:Freeze="True"
     Color="{StaticResource Primary4Color}" />
</ResourceDictionary>
