<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:AntWpf.Controls"
    xmlns:converters="clr-namespace:AntWpf.Converters"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--  Modal: a placeholder in the page; its dialog is shown in the window overlay  -->
    <Style TargetType="{x:Type Controls:Modal}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="{DynamicResource ModalWidth}" />
        <!--  The modal content inherits these (its logical parent is the Modal)  -->
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Controls:Modal}" />
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Close (x) button of the dialog  -->
    <Style x:Key="Ant.ModalCloseButton" TargetType="{x:Type Button}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Width" Value="{DynamicResource ModalCloseSize}" />
        <Setter Property="Height" Value="{DynamicResource ModalCloseSize}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border
                        x:Name="Background"
                        Background="Transparent"
                        CornerRadius="{DynamicResource BorderRadiusBase}">
                        <Controls:AntIcon
                            x:Name="Icon"
                            Width="16"
                            Height="16"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource IconBrush}"
                            Key="CloseOutlined" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Background" Property="Background" Value="{DynamicResource TextHoverBackgroundBrush}" />
                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource IconHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Background" Property="Background" Value="{DynamicResource TextHoverBackgroundBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Controls:ModalDialog}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Controls:ModalDialog}">
                    <Grid>
                        <Grid.Resources>
                            <!--  Text content wraps and uses the Ant Design line height (1.5714)  -->
                            <DataTemplate DataType="{x:Type sys:String}">
                                <TextBlock
                                    LineHeight="{Binding FontSize, RelativeSource={RelativeSource Self}, Converter={converters:MathConverter Operation=Multiply}, ConverterParameter=1.5714}"
                                    LineStackingStrategy="BlockLineHeight"
                                    Text="{Binding}"
                                    TextWrapping="Wrap" />
                            </DataTemplate>
                        </Grid.Resources>

                        <!--  Mask: blocks the window behind the dialog  -->
                        <Border
                            x:Name="PART_Mask"
                            Background="{DynamicResource ModalMaskBrush}"
                            Opacity="0" />

                        <ScrollViewer
                            x:Name="PART_Wrapper"
                            Focusable="False"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <Border
                                x:Name="PART_Panel"
                                Width="{TemplateBinding DialogWidth}"
                                Margin="{DynamicResource ModalMargin}"
                                Padding="{DynamicResource ModalPadding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Background="{DynamicResource ElevatedBackgroundBrush}"
                                CornerRadius="{DynamicResource ModalBorderRadius}"
                                FocusVisualStyle="{x:Null}"
                                Focusable="True"
                                KeyboardNavigation.ControlTabNavigation="Cycle"
                                KeyboardNavigation.DirectionalNavigation="Contained"
                                KeyboardNavigation.TabNavigation="Cycle"
                                Opacity="0">
                                <Border.Effect>
                                    <!--  Approximation of the Ant Design boxShadow  -->
                                    <DropShadowEffect
                                        BlurRadius="28"
                                        Direction="270"
                                        Opacity="0.16"
                                        ShadowDepth="6"
                                        Color="{DynamicResource ShadowColor}" />
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!--  Header  -->
                                    <ContentPresenter
                                        x:Name="Header"
                                        Margin="0,0,32,8"
                                        Content="{TemplateBinding Title}"
                                        TextElement.FontSize="{DynamicResource ModalTitleFontSize}"
                                        TextElement.FontWeight="SemiBold"
                                        TextElement.Foreground="{DynamicResource HeadingBrush}" />
                                    <Button
                                        x:Name="PART_Close"
                                        Margin="0,-3,-7,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Style="{StaticResource Ant.ModalCloseButton}" />

                                    <!--  Body  -->
                                    <ContentPresenter
                                        x:Name="Body"
                                        Grid.Row="1"
                                        Content="{TemplateBinding Body}"
                                        ContentTemplate="{TemplateBinding BodyTemplate}" />

                                    <!--  Confirm body: icon, title and content  -->
                                    <Grid x:Name="ConfirmBody" Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Controls:AntIcon
                                            x:Name="ConfirmIcon"
                                            Width="{DynamicResource ModalConfirmIconSize}"
                                            Height="{DynamicResource ModalConfirmIconSize}"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Top"
                                            Foreground="{DynamicResource WarningBrush}"
                                            Key="ExclamationCircleFilled" />
                                        <StackPanel Grid.Column="1">
                                            <ContentPresenter
                                                Content="{TemplateBinding Title}"
                                                TextElement.FontSize="{DynamicResource ModalTitleFontSize}"
                                                TextElement.FontWeight="SemiBold"
                                                TextElement.Foreground="{DynamicResource HeadingBrush}" />
                                            <ContentPresenter
                                                x:Name="ConfirmContent"
                                                Margin="0,8,0,0"
                                                Content="{TemplateBinding Body}" />
                                        </StackPanel>
                                    </Grid>

                                    <!--  Footer  -->
                                    <Grid
                                        x:Name="FooterArea"
                                        Grid.Row="2"
                                        Margin="0,24,0,0">
                                        <ContentPresenter x:Name="CustomFooter" Content="{TemplateBinding Footer}" />
                                        <StackPanel
                                            x:Name="DefaultFooter"
                                            HorizontalAlignment="Right"
                                            Orientation="Horizontal"
                                            Visibility="Collapsed">
                                            <Controls:Button
                                                x:Name="PART_Cancel"
                                                Margin="0,0,8,0"
                                                Content="{TemplateBinding CancelText}" />
                                            <Controls:Button
                                                x:Name="PART_Ok"
                                                Content="{TemplateBinding OkText}"
                                                Loading="{TemplateBinding OkButtonLoading}"
                                                Type="Primary" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </ScrollViewer>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!--  Normal dialog (no confirm type)  -->
                        <Trigger Property="Type" Value="{x:Null}">
                            <Setter TargetName="ConfirmBody" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="FooterArea" Property="Margin" Value="0,12,0,0" />
                        </Trigger>
                        <Trigger Property="Title" Value="{x:Null}">
                            <Setter TargetName="Header" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Closable" Value="False">
                            <Setter TargetName="PART_Close" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Footer" Value="{x:Null}">
                            <Setter TargetName="CustomFooter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="DefaultFooter" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="ShowCancel" Value="False">
                            <Setter TargetName="PART_Cancel" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Body" Value="{x:Null}">
                            <Setter TargetName="ConfirmContent" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Centered" Value="True">
                            <Setter TargetName="PART_Panel" Property="VerticalAlignment" Value="Center" />
                            <Setter TargetName="PART_Panel" Property="Margin" Value="16,24" />
                        </Trigger>
                        <!--  Confirm types  -->
                        <Trigger Property="Type" Value="Info">
                            <Setter TargetName="ConfirmIcon" Property="Key" Value="InfoCircleFilled" />
                            <Setter TargetName="ConfirmIcon" Property="Foreground" Value="{DynamicResource InfoBrush}" />
                        </Trigger>
                        <Trigger Property="Type" Value="Success">
                            <Setter TargetName="ConfirmIcon" Property="Key" Value="CheckCircleFilled" />
                            <Setter TargetName="ConfirmIcon" Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                        </Trigger>
                        <Trigger Property="Type" Value="Error">
                            <Setter TargetName="ConfirmIcon" Property="Key" Value="CloseCircleFilled" />
                            <Setter TargetName="ConfirmIcon" Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                        </Trigger>
                        <!--  Confirm layout hides the normal header and body (set last so it wins)  -->
                        <Trigger Property="Type" Value="Confirm">
                            <Setter TargetName="Header" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Body" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_Close" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Type" Value="Info">
                            <Setter TargetName="Header" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Body" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_Close" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Type" Value="Success">
                            <Setter TargetName="Header" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Body" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_Close" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Type" Value="Error">
                            <Setter TargetName="Header" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Body" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_Close" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Type" Value="Warning">
                            <Setter TargetName="Header" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Body" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_Close" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
