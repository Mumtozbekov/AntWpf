<Window x:Class="AntDesignSample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:Ant="clr-namespace:AntWpf.Controls;assembly=AntWpf"
        mc:Ignorable="d"
        d:Height="600"
        Title="MainWindow" MinHeight="450" MinWidth="600" Width="1000" Height="720"
        Background="{DynamicResource BodyBackground}"
        Foreground="{DynamicResource TextBrush}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrushSecondary}">
            <Ant:Button x:Name="themeButton" HorizontalAlignment="Right" Content="Dark" Click="ThemeButton_Click"/>
        </Border>
        <Border DockPanel.Dock="Left" Width="180" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource BorderBrushSecondary}">
            <ListBox x:Name="navigation" Style="{StaticResource Sample.Navigation}" SelectionChanged="Navigation_SelectionChanged">
                <ListBoxItem Content="General" Tag="General" />
                <ListBoxItem Content="Icons" Tag="Icons" />
                <ListBoxItem Content="Tag" Tag="Tag" />
                <ListBoxItem Content="Badge" Tag="Badge" />
            </ListBox>
        </Border>
        <ContentControl x:Name="page" Focusable="False" />
    </DockPanel>
</Window>
