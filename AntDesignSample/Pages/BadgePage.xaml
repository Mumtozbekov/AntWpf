<UserControl x:Class="AntDesignSample.Pages.BadgePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Ant="clr-namespace:AntWpf.Controls;assembly=AntWpf">
    <UserControl.Resources>
        <!--  Square placeholder like Ant's shape avatar  -->
        <Style x:Key="Sample.Square" TargetType="Border">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="{DynamicResource BorderRadiusBase}" />
            <Setter Property="Background" Value="{DynamicResource AvatarBackground}" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <TextBlock Text="Basic" Style="{StaticResource Sample.SectionTitle}" />
            <WrapPanel>
                <Ant:Badge Count="5" Margin="0,8,24,8"><Border Style="{StaticResource Sample.Square}" /></Ant:Badge>
                <Ant:Badge Count="0" ShowZero="True" Margin="0,8,24,8"><Border Style="{StaticResource Sample.Square}" /></Ant:Badge>
                <Ant:Badge Count="5" Size="Small" Margin="0,8,24,8"><Border Style="{StaticResource Sample.Square}" /></Ant:Badge>
                <Ant:Badge Count="25" Margin="0,8,24,8" VerticalAlignment="Center" />
            </WrapPanel>

            <TextBlock Text="Overflow count" Style="{StaticResource Sample.SectionTitle}" />
            <WrapPanel>
                <Ant:Badge Count="99" Margin="0,8,32,8"><Border Style="{StaticResource Sample.Square}" /></Ant:Badge>
                <Ant:Badge Count="100" Margin="0,8,32,8"><Border Style="{StaticResource Sample.Square}" /></Ant:Badge>
                <Ant:Badge Count="99" OverflowCount="10" Margin="0,8,32,8"><Border Style="{StaticResource Sample.Square}" /></Ant:Badge>
                <Ant:Badge Count="1000" OverflowCount="999" Margin="0,8,32,8"><Border Style="{StaticResource Sample.Square}" /></Ant:Badge>
            </WrapPanel>

            <TextBlock Text="Dynamic" Style="{StaticResource Sample.SectionTitle}" />
            <StackPanel Orientation="Horizontal">
                <Ant:Badge x:Name="dynamicBadge" Count="5" Margin="0,8,24,8"><Border Style="{StaticResource Sample.Square}" /></Ant:Badge>
                <Ant:Button Content="−" Width="32" Padding="0" Margin="0,0,8,0" Click="Decrease_Click" />
                <Ant:Button Content="+" Width="32" Padding="0" Margin="0,0,24,0" Click="Increase_Click" />
                <Ant:Badge x:Name="dotBadge" Dot="{Binding IsChecked, ElementName=dotSwitch}" Margin="0,8,16,8"><Border Style="{StaticResource Sample.Square}" /></Ant:Badge>
                <Ant:Switch x:Name="dotSwitch" IsChecked="True" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Text="Dot and offset" Style="{StaticResource Sample.SectionTitle}" />
            <WrapPanel>
                <Ant:Badge Dot="True" Margin="0,8,24,8"><Ant:AntIcon Key="NotificationOutlined" Width="16" Height="16" /></Ant:Badge>
                <Ant:Badge Dot="True" Margin="0,8,24,8"><TextBlock Text="Link something" Foreground="{DynamicResource LinkBrush}" /></Ant:Badge>
                <Ant:Badge Count="5" Offset="10,10" Margin="0,8,24,8"><Border Style="{StaticResource Sample.Square}" /></Ant:Badge>
            </WrapPanel>

            <TextBlock Text="Status" Style="{StaticResource Sample.SectionTitle}" />
            <WrapPanel>
                <Ant:Badge Status="Success" Margin="0,0,16,0" />
                <Ant:Badge Status="Error" Margin="0,0,16,0" />
                <Ant:Badge Status="Default" Margin="0,0,16,0" />
                <Ant:Badge Status="Processing" Margin="0,0,16,0" />
                <Ant:Badge Status="Warning" Margin="0,0,16,0" />
            </WrapPanel>
            <StackPanel Margin="0,8,0,0">
                <Ant:Badge Status="Success" Text="Success" Margin="0,2" />
                <Ant:Badge Status="Error" Text="Error" Margin="0,2" />
                <Ant:Badge Status="Default" Text="Default" Margin="0,2" />
                <Ant:Badge Status="Processing" Text="Processing" Margin="0,2" />
                <Ant:Badge Status="Warning" Text="Warning" Margin="0,2" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
